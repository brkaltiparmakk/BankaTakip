# ---- Mail hesapları (config.yaml kullanmıyorsanız bu yeterli) ----
GMAIL_EMAIL=ornek@gmail.com
# Google Hesabı > Güvenlik > 2 Adımlı Doğrulama > Uygulama şifreleri
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

ICLOUD_EMAIL=ornek@icloud.com
# appleid.apple.com > Oturum Açma ve Güvenlik > Uygulamaya özel parolalar
ICLOUD_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ---- Şifreli ekstre PDF'leri (genelde TCKN'nin bir kısmı veya doğum tarihi) ----
GARANTI_PDF_PASSWORD=
YAPIKREDI_PDF_PASSWORD=
ISBANK_PDF_PASSWORD=
AKBANK_PDF_PASSWORD=

# ---- Veritabanı: boşsa yerelde data/bankatakip.db (SQLite) kullanılır ----
# Vercel'de Neon entegrasyonu bunu otomatik tanımlar.
DATABASE_URL=

# ---- Web paneli girişi (Google) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# En az 32 karakter: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# Panele girebilecek Google adresleri, virgülle ayrılmış
ALLOWED_EMAILS=ornek@gmail.com
# Vercel Cron isteklerini doğrulamak için rastgele bir metin
CRON_SECRET=

# Yerelde girişsiz denemek için (Vercel'de yok sayılır)
# AUTH_DISABLED=1
